{
	"name": "revly-workspace",
	"version": "0.0.0",
	"scripts": {
		"ng": "ng",
		"start": "ng serve",
		"build": "ng build",
		"watch": "ng build --watch --configuration development",
		"test": "ng test",
		"lint": "ng lint",
		"format:check": "prettier --check \"**/*.{js,ts,json,yml,yaml,css,scss,html}\"",
		"format:write": "prettier --write \"**/*.{js,ts,json,yml,yaml,css,scss,html}\"",
		"build:revly": "npm run format:check && npm run build -- --project=revly --configuration=production",
		"build:revly-admin": "npm run format:check && npm run build -- --project=revly-admin --configuration=production",
		"serve:ssr:revly": "node dist/revly/server/server.mjs"
	},
	"private": true,
	"dependencies": {
		"@angular/cdk": "^20.2.14",
		"@angular/common": "^20.3.13",
		"@angular/compiler": "^20.3.13",
		"@angular/core": "^20.3.13",
		"@angular/forms": "^20.3.13",
		"@angular/material": "^20.2.14",
		"@angular/platform-browser": "^20.3.13",
		"@angular/platform-browser-dynamic": "^20.3.13",
		"@angular/platform-server": "^20.3.13",
		"@angular/router": "^20.3.13",
		"@angular/ssr": "^20.3.13",
		"@ngrx/effects": "^20.1.0",
		"@ngrx/store": "^20.1.0",
		"@ngrx/store-devtools": "^20.1.0",
		"@tailwindcss/postcss": "^4.1.16",
		"express": "^5.1.0",
		"leaflet": "^1.9.4",
		"rxjs": "~7.8.0",
		"tslib": "^2.3.0",
		"zone.js": "~0.15.0"
	},
	"devDependencies": {
		"@angular-devkit/build-angular": "^20.3.13",
		"@angular/build": "^20.3.13",
		"@angular/cli": "^20.3.13",
		"@angular/compiler-cli": "^20.3.13",
		"@ngrx/schematics": "^20.1.0",
		"@types/express": "^5.0.1",
		"@types/jasmine": "~5.1.0",
		"@types/leaflet": "^1.9.21",
		"@types/node": "^20.17.19",
		"angular-eslint": "19.4.0",
		"autoprefixer": "^10.4.21",
		"eslint": "^9.26.0",
		"jasmine-core": "~5.6.0",
		"karma": "~6.4.0",
		"karma-chrome-launcher": "~3.2.0",
		"karma-coverage": "~2.2.0",
		"karma-jasmine": "~5.1.0",
		"karma-jasmine-html-reporter": "~2.1.0",
		"ng-packagr": "^20.0.0",
		"postcss": "^8.5.6",
		"prettier": "^3.5.3",
		"prettier-plugin-organize-attributes": "^1.0.0",
		"tailwindcss": "^4.1.16",
		"typescript": "~5.8.3",
		"typescript-eslint": "8.32.0"
	}
}
