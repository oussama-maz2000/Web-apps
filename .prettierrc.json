{
	"bracketSameLine": true,
	"useTabs": true,
	"singleAttributePerLine": false,
	"trailingComma": "none",
	"endOfLine": "lf",
	"singleQuote": true,
	"printWidth": 120,
	"overrides": [
		{
			"files": "*.html",
			"options": {
				"parser": "angular",
				"printWidth": 115
			}
		},

		{
			"files": ["*.ts", "*.js"],
			"options": {
				"printWidth": 115
			}
		}
	]
}
